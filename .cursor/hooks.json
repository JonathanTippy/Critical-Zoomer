{
  "version": 1,
  "hooks": {
    "sessionStart": [],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-raw-kill.sh",
        "matcher": "pkill|killall|(?:^|[\\s;|&])kill\\s",
        "timeout": 20
      },
      {
        "command": ".cursor/hooks/kill-test-zombies.sh --hook-before",
        "matcher": "cargo test|cargo bench|screenshot_check",
        "timeout": 15
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/kill-test-zombies.sh --hook-after",
        "matcher": "cargo test|cargo bench|screenshot_check",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [],
    "stop": [
      {
        "command": ".cursor/hooks/kill-test-zombies.sh --hook-stop",
        "timeout": 15
      },
      {
        "command": "bash .cursor/hooks/full_check_on_stop.sh",
        "timeout": 2400,
        "loop_limit": 3
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/workgroup-rules.sh",
        "matcher": "Write|StrReplace|EditNotebook",
        "timeout": 10
      }
    ]
  }
}
